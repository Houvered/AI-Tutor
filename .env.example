# ===================================================================
# StudyMate environment configuration
# Copy this file to .env and fill in your values. Never commit .env.
# ===================================================================

# LLM provider
# -------------
# Choose which API format to use:
#   openai  = any OpenAI-compatible API (default)
#   gemini  = Google Gemini API
LLM_PROVIDER=openai

# --- Provider: openai ----------------------------------------------
# Base address of your provider. Examples:
#   OpenAI:     https://api.openai.com/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Groq:       https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1

# Your secret API key. Keep it private, never commit it.
LLM_API_KEY=sk-your-key-here

# Model used for chat answers and quiz questions.
LLM_MODEL=gpt-4o-mini

# Model used to turn text into numbers for search.
# OpenAI example: text-embedding-3-small
EMBED_MODEL=text-embedding-3-small

# --- Provider: gemini ----------------------------------------------
# Used only when LLM_PROVIDER=gemini. Get a key from Google AI Studio.
GEMINI_API_KEY=your-gemini-key-here

# Models for chat and embeddings.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# App
# ---
# Port the server listens on (uvicorn flag usually overrides this).
# Host address used when running behind a proxy.
HOST=0.0.0.0
PORT=8000